# Halium/UBports additions on top of exynos9610-a50_core_defconfig
CONFIG_SYSVIPC=y
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_OVERLAY_FS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_AUTOFS4_FS=y
CONFIG_FUSE_FS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_INOTIFY_USER=y
CONFIG_CGROUP_SCHED=y
CONFIG_COMPAT_VDSO=n
CONFIG_LTO_NONE=y
CONFIG_CC_STACKPROTECTOR_STRONG=y
CONFIG_LLVM_POLLY=n
CONFIG_MALI_MIDGARD=y
CONFIG_SDP=y
CONFIG_FSCRYPT_SDP=y

# Halium check-kernel-config requirements supported by Mint 4.14.
CONFIG_AUDIT=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_CGROUP_PERF=y
CONFIG_SCHED_TUNE=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=32768
CONFIG_CORE_DUMP_DEFAULT_ELF_HEADERS=y
CONFIG_XFRM_STATISTICS=n
CONFIG_SYN_COOKIES=y
CONFIG_INET_AH=y
CONFIG_INET_IPCOMP=y
CONFIG_INET_XFRM_MODE_BEET=y
CONFIG_NETLABEL=y
CONFIG_ANDROID_PARANOID_NETWORK=n
CONFIG_NETFILTER_NETLINK_ACCT=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_TARGET_DSCP=y
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_NETFILTER_XT_TARGET_LED=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_NOTRACK=y
CONFIG_NETFILTER_XT_TARGET_RATEEST=y
CONFIG_NETFILTER_XT_TARGET_TEE=y
CONFIG_NETFILTER_XT_TARGET_TCPOPTSTRIP=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CLUSTER=y
CONFIG_NETFILTER_XT_MATCH_CPU=y
CONFIG_NETFILTER_XT_MATCH_DCCP=y
CONFIG_NETFILTER_XT_MATCH_DEVGROUP=y
CONFIG_NETFILTER_XT_MATCH_DSCP=y
CONFIG_NETFILTER_XT_MATCH_ESP=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_NFACCT=y
CONFIG_NETFILTER_XT_MATCH_OSF=y
CONFIG_NETFILTER_XT_MATCH_RATEEST=y
CONFIG_NETFILTER_XT_MATCH_REALM=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_IP6_NF_MATCH_AH=y
CONFIG_IP6_NF_MATCH_EUI64=y
CONFIG_IP6_NF_MATCH_FRAG=y
CONFIG_IP6_NF_MATCH_OPTS=y
CONFIG_IP6_NF_MATCH_HL=y
CONFIG_IP6_NF_MATCH_IPV6HEADER=y
CONFIG_IP6_NF_MATCH_MH=y
CONFIG_IP6_NF_MATCH_RT=y
CONFIG_IP6_NF_TARGET_HL=y
CONFIG_IP6_NF_SECURITY=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_DNS_RESOLVER=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_BT=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_VT=y
CONFIG_FANOTIFY=y
CONFIG_ECRYPT_FS_MESSAGING=y
CONFIG_SQUASHFS_DECOMP_MULTI=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_4K_DEVBLK_SIZE=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DISABLE=y
CONFIG_SECURITY_TOMOYO=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_INTEGRITY_SIGNATURE=y
CONFIG_EVM=y
CONFIG_DEFAULT_SECURITY="selinux"
CONFIG_AUDITSYSCALL=y
CONFIG_AUDIT_TREE=y
CONFIG_AUDIT_WATCH=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HCIVHCI=y
CONFIG_BT_HIDP=y
CONFIG_NETFILTER_XT_TARGET_AUDIT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=1
CONFIG_SECURITY_TOMOYO_MAX_ACCEPT_ENTRY=2048
CONFIG_SECURITY_TOMOYO_MAX_AUDIT_LOG=1024
CONFIG_SECURITY_TOMOYO_POLICY_LOADER="/sbin/tomoyo-init"
CONFIG_SECURITY_TOMOYO_ACTIVATION_TRIGGER="/sbin/init"
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_SECURITY_SMACK=n
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=n
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,anbox-binder,anbox-hwbinder,anbox-vndbinder"

# Halium uses AppArmor and does not need KernelSU.
CONFIG_KSU=n

# Samsung passes console=ram in DT and ignores the boot header cmdline.
CONFIG_CMDLINE="quiet androidboot.init_fatal_panic=true androidboot.init_fatal_reboot_target=recovery rcu_nocbs=0-3 noirqdebug nosoftlockup mce=ignore_ce cgroup_disable=pressure console=tty0 security=selinux selinux=1 enforcing=0 androidboot.selinux=permissive systemd.log_target=kmsg systemd.log_level=info slub_debug=U,kmalloc-2048"

# Audio DSP (ABOX/calliope) and TFA9872 amp firmware must exist at driver probe, before rootfs is mounted.
CONFIG_EXTRA_FIRMWARE="calliope_sram.bin calliope_dram.bin calliope_iva.bin Tfa9872.cnt"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

# Bluetooth (bluebinder) needs /dev/rfkill
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y


# /proc/slabinfo for leak hunting
CONFIG_SLUB_DEBUG=y
